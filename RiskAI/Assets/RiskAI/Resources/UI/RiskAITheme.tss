@import url("unity-theme://default");

.unity-text-field__input {
    background-color: rgb(25, 38, 47);
    color: rgb(237, 235, 216);
    border-color: rgb(145, 111, 57);
    padding-left: 8px;
}
.unity-scroller {
    background-color: rgba(12, 21, 28, 0.7);
}
.unity-scroller .unity-base-slider__dragger {
    background-color: rgb(101, 115, 112);
    border-radius: 3px;
}
.unity-scroller__low-button, .unity-scroller__high-button {
    background-color: rgb(39, 54, 62);
    -unity-background-image-tint-color: rgb(221, 182, 111);
}
.unity-scroller .unity-button {
    background-image: none;
    background-color: rgb(39, 54, 62);
    border-color: rgb(101, 115, 112);
}
.unity-scroller .unity-base-slider__tracker {
    background-color: rgb(19, 31, 39);
    border-color: rgb(39, 54, 62);
}
.unity-scroller .unity-base-slider__dragger {
    background-image: none;
    border-color: rgb(101, 115, 112);
}
